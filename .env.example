# Runtime mode: offline starts the local shell without external providers.
RUNTIME_MODE=offline
NODE_ENV=development
API_HOST=127.0.0.1
# Render supplies PORT automatically; API_PORT remains the local override.
API_PORT=8787
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Supabase (required when RUNTIME_MODE=connected)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Server-side migration scripts only; never expose this value to the browser.
SUPABASE_DB_URL=

# DeepSeek generation and tool calling
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000
# Conservative peak, cache-miss rates for deepseek-v4-flash as of 2026-08-30.
DEEPSEEK_INPUT_COST_PER_MILLION_USD=0.44
DEEPSEEK_OUTPUT_COST_PER_MILLION_USD=1.32

# SiliconFlow multilingual embeddings
SILICONFLOW_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_MS=20000

# Public demo safety limits
DEMO_DAILY_REQUEST_LIMIT=120
DEMO_DAILY_TOKEN_LIMIT=250000
PUBLIC_CHAT_RATE_LIMIT=12
PUBLIC_CHAT_RATE_WINDOW_MS=60000
MAX_UPLOAD_BYTES=10485760
MAX_WORKSPACE_DOCUMENTS=20
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=180

# Webhook delivery
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_ATTEMPTS=3

# Frontend-only public values
VITE_API_BASE_URL=http://localhost:8787
# Optional public repository link displayed on the landing page.
VITE_GITHUB_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
