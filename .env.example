# Runtime mode: offline starts the local shell without external providers.
RUNTIME_MODE=offline
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Supabase (required when RUNTIME_MODE=connected)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# DeepSeek generation and tool calling
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000

# SiliconFlow multilingual embeddings
SILICONFLOW_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_MS=20000

# Public demo safety limits
DEMO_DAILY_REQUEST_LIMIT=120
DEMO_DAILY_TOKEN_LIMIT=250000
PUBLIC_CHAT_RATE_LIMIT=12
PUBLIC_CHAT_RATE_WINDOW_MS=60000
MAX_UPLOAD_BYTES=10485760
MAX_WORKSPACE_DOCUMENTS=20

# Webhook delivery
WEBHOOK_TIMEOUT_MS=8000
WEBHOOK_MAX_ATTEMPTS=3

# Frontend-only public values
VITE_API_BASE_URL=http://localhost:8787
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
