{
  "name": "@grounddesk/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:unit": "vitest run tests/env.test.ts",
    "env:check": "tsx src/config/check-env.ts",
    "db:migrate": "tsx src/db/apply-sql.ts migrate",
    "db:seed": "tsx src/db/apply-sql.ts seed",
    "db:verify": "tsx src/db/verify-database.ts",
    "auth:bootstrap": "tsx src/auth/bootstrap-demo-users.ts",
    "auth:smoke": "tsx src/auth/smoke-auth.ts",
    "knowledge:bootstrap": "tsx src/knowledge/bootstrap-demo-knowledge.ts",
    "knowledge:reindex": "tsx src/knowledge/bootstrap-demo-knowledge.ts --reindex",
    "knowledge:smoke": "tsx src/knowledge/smoke-retrieval.ts",
    "knowledge:http-smoke": "tsx src/knowledge/smoke-http.ts",
    "knowledge:diagnose": "tsx src/knowledge/diagnose-query.ts",
    "agent:smoke": "tsx src/agent/smoke-agent.ts",
    "tickets:smoke": "tsx src/tickets/smoke-tickets.ts",
    "eval:smoke": "tsx src/evaluations/smoke-evaluation.ts",
    "eval:live": "tsx src/evaluations/smoke-evaluation.ts --live",
    "eval:report": "tsx src/evaluations/report-evaluation.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@grounddesk/shared": "workspace:*",
    "@supabase/supabase-js": "^2.87.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "jose": "^6.1.2",
    "postgres": "^3.4.7",
    "unpdf": "1.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
